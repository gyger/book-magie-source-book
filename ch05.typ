  image("figures/fig66.svg", width: 65%, alt: "Two overlapping series of concentric circular waves radiating from closely spaced sources A and B on the left and interfering across a rectangular field to produce alternating lines of reinforcement and cancellation reaching points C, D, E, and F on the right."),
  caption: [],
