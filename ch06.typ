  image("figures/fig86.svg", width: 72%, alt: "Ampère's apparatus under a glass cover for demonstrating attraction and repulsion between a fixed horizontal conductor AB and a parallel movable conductor CD suspended on steel points from a counterweighted glass rod."),
  caption: [],
